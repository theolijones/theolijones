# ─── AWS Configuration ─────────────────────────────────────────
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=

# ─── Cognito ───────────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=https://velox-ACCOUNT_ID.auth.ap-southeast-2.amazoncognito.com

# ─── S3 Buckets ────────────────────────────────────────────────
S3_BUCKET_VIDEO_SOURCE=velox-video-source-ACCOUNT_ID
S3_BUCKET_VIDEO_OUTPUT=velox-video-output-ACCOUNT_ID
S3_BUCKET_THUMBNAILS=velox-thumbnails-ACCOUNT_ID
S3_BUCKET_CAPTIONS=velox-captions-ACCOUNT_ID
S3_BUCKET_TRANSCRIPTS=velox-transcripts-ACCOUNT_ID

# ─── CloudFront ────────────────────────────────────────────────
CLOUDFRONT_DOMAIN=

# ─── MediaConvert ──────────────────────────────────────────────
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

# ─── SNS Topics ────────────────────────────────────────────────
SNS_VIDEO_PROCESSING_TOPIC_ARN=
SNS_QA_NOTIFICATION_TOPIC_ARN=

# ─── API Server ────────────────────────────────────────────────
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ─── Frontend (Vite — prefix with VITE_) ──────────────────────
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_API_BASE_URL=/api/v1
VITE_GA_MEASUREMENT_ID=
VITE_BITMOVIN_PLAYER_KEY=4578c6b5-0415-4969-babb-2ade8182e493
